<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="session-shelf.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Moreno Land\Session Shelf">
    </Installer>
    <PackageInformation
        PackageName="Session Shelf"
        PackageDisplayName="Session Shelf"
        PublisherName="CN=Moreno Land"
        PublisherDisplayName="Moreno Land"
        Version="0.1.0.0"
        PackageDescription="Local cross-platform desktop manager for Codex JSONL sessions">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="com.morenoland.codexsessionmanager"
                Description="Local cross-platform desktop manager for Codex JSONL sessions"
                DisplayName="Session Shelf"
                ExecutableName="session-shelf.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Session Shelf</DisplayName>
            <PublisherDisplayName>Moreno Land</PublisherDisplayName>
            <Description>Local cross-platform desktop manager for Codex JSONL sessions</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="session_shelf.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
